# ==============================================================================
# AI-Vibe-Coding — Cấu hình Môi trường Mẫu (.env.example)
# Nền tảng: Antigravity 2.0 | Kiến trúc: 5 Sub-Teams Multi-Agent
# ==============================================================================

# Thông tin Dự án
ENVIRONMENT=development
PROJECT_NAME="AI-Vibe-Coding"
DEBUG=True
SECRET_KEY=change_this_to_a_super_secret_key_in_production_32chars
API_V1_STR=/api/v1
# API_V1_PREFIX=/api/v1 (Bí danh tương thích ngược từ AI-Team-Dev)
LOG_LEVEL=INFO
PORT=3000
BACKEND_PORT=8000

# Google Gemini / Antigravity API Credentials (Tuỳ chọn: Dùng khi chạy standalone scripts ngoài IDE)
# Lấy API key tại: https://aistudio.google.com/app/api-keys
# GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Database Configuration (PostgreSQL / Supabase / SQLite)
# ==============================================================================

# Option A: Local PostgreSQL (Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vibe_db

# Option B: Supabase (Hosted PostgreSQL)
# 1. DATABASE_URL: Dùng cho FastAPI App Runtime qua Supavisor Transaction Pooler (port 6543)
#    Lưu ý: Supavisor Transaction mode yêu cầu prepared_statement_cache_size=0 (đã auto-handle trong session.py)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require&prepared_statement_cache_size=0
#
# 2. DIRECT_DATABASE_URL: Dùng cho Alembic Migrations qua Session Mode (port 5432)
# DIRECT_DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require

# In-memory database for isolated automated testing (Pytest)
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Supabase Auth/Storage Integration (Optional)
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_ANON_KEY=eyJh...
# SUPABASE_SERVICE_ROLE_KEY=eyJh...

# ==============================================================================
# CORS & Network Configuration
# ==============================================================================
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000", "http://localhost:8081"]

# ==============================================================================
# Frontend Client Configuration (Web & Mobile)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://127.0.0.1:8000

# Set to 'true' during Wave 1 (Frontend mock testing), set to 'false' for Wave 2 & Production (Live API)
NEXT_PUBLIC_USE_MOCKS=false

# ==============================================================================
# Human-in-the-Loop & Quality Gates
# ==============================================================================
# true: dừng lại hỏi người dùng tại Gate 1, 2, 3; false: tự động bypass cho CI/CD
HITL_ENABLED=true
COV_FAIL_UNDER=80
STRICT_SCHEMA_DRIFT_CHECK=true

# ==============================================================================
# Model Allocation Matrix & Token Optimization (Google Antigravity 2.0 / Gemini)
# ==============================================================================
# Lựa chọn 1: Mặc định Gemini 2.5 Series
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_FLASH_LITE_MODEL=gemini-2.5-flash-lite

# Lựa chọn 2: Sẵn sàng cho thế hệ Gemini 3.8 Series trên Antigravity 2.0 (bỏ comment để bật)
# GEMINI_PRO_MODEL=gemini-3.8-pro
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_FLASH_LITE_MODEL=gemini-3.8-flash-lite

# Lựa chọn 3: Ghi đè chi tiết theo từng Tác tử / Role (Per-Agent Model Overrides)
# ACCOUNT_LEAD_MODEL=gemini-2.5-flash
# BA_MODEL=gemini-2.5-pro
# UIUX_MODEL=gemini-2.5-flash
# ARCHITECT_MODEL=gemini-2.5-pro
# SECURITY_ARCHITECT_MODEL=gemini-2.5-pro
# PLANNER_MODEL=gemini-2.5-pro
# DB_DEV_MODEL=gemini-2.5-flash
# FRONTEND_DEV_MODEL=gemini-2.5-flash
# BACKEND_DEV_MODEL=gemini-2.5-pro
# DEVOPS_MODEL=gemini-2.5-flash
# QA_MODEL=gemini-2.5-flash
# CODE_REVIEW_MODEL=gemini-2.5-pro
# RELEASE_MODEL=gemini-2.5-flash-lite
# TECH_WRITER_MODEL=gemini-2.5-flash-lite
# HANDOVER_MODEL=gemini-2.5-flash
# FAST_TRACK_MODEL=gemini-2.5-flash

