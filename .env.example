# Cấu hình Môi trường Mẫu cho AI-Vibe-Coding
ENVIRONMENT=development
PROJECT_NAME="AI-Vibe-Coding"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_super_secret_key_in_production_32chars

# Database URL: PostgreSQL khi chạy Docker / Production
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vibe_db

# Database URL: SQLite async dùng khi chạy test cô lập
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Frontend Ports
PORT=3000
BACKEND_PORT=8000
